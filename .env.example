# Copy this file to .env and adjust if needed. Never commit .env.

# --- Local web app (keep it on loopback; do not expose to the internet) ---
APP_HOST=127.0.0.1
APP_PORT=8765
LOG_LEVEL=INFO

# --- Ollama (local only) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_S=600
OLLAMA_KEEP_ALIVE=30m
# Thinking mode improves reasoning but roughly doubles latency on CPU.
OLLAMA_THINK=false

# --- Browser ---
# Chrome is already installed on this machine, so we use channel=chrome.
BROWSER_CHANNEL=chrome
# The browser MUST stay visible for manual Moodle login and user oversight.
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
BROWSER_PROFILE_DIR=browser/profile

# --- Moodle ---
# Defaults to the DSU LMS. Change it here or in the dashboard at runtime.
MOODLE_URL=https://lms.dsu.edu.pk/

# --- Safety limits ---
MAX_DOWNLOAD_MB=50
MAX_PAGE_CHARS=14000
MAX_TOOL_RESULT_CHARS=8000
APPROVAL_TIMEOUT_S=300
MAX_AGENT_ITERATIONS=12
